# systemd unit for the proxy app.
# Adjust User, Group and paths to your installation.

[Unit]
Description=Scramjet Web Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy
Group=proxy
WorkingDirectory=/opt/web-proxy
ExecStart=/usr/bin/node /opt/web-proxy/server.js
Environment=NODE_ENV=production
Restart=always
RestartSec=5
Nice=-5
CPUWeight=500
IOWeight=500
OOMScoreAdjust=-300

# Aislamiento del servicio. Ajusta ReadWritePaths si tu instalación vive en otra ruta.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/web-proxy/data /opt/web-proxy/backups /var/backups/proxy

[Install]
WantedBy=multi-user.target
