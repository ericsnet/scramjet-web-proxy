{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self' blob: data: https:; connect-src 'self' https: wss: data: blob:; frame-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		-Server
	}

	@wisp path /wisp/*
	reverse_proxy @wisp proxy:3030

	reverse_proxy proxy:3030

	header /sw.js {
		Cache-Control "no-store, no-cache, must-revalidate"
		Service-Worker-Allowed "/"
	}
}
